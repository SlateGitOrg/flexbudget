	partition Standards = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/Standards.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CostLine", type text}, {"VisitType", type text}, {"UnitCost", type number}, {"StdHours", type number}, {"StdWageRate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
